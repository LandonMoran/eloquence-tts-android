<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.xw.vvtts"
    android:versionCode="4"
    android:versionName="1.0.3">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="36" />
    <queries>
        <package android:name="com.android.packageinstaller" />
        <package android:name="com.google.android.packageinstaller" />
    </queries>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Signature-level gate for the install-status broadcast channel
         (ElqUpdateInstaller registers its receiver with this permission
         on devices below Android 13, where RECEIVER_NOT_EXPORTED is absent). -->
    <permission
        android:name="com.xw.vvtts.permission.INSTALL_STATUS"
        android:protectionLevel="signature" />

    <application
        android:label="@string/app_name"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:theme="@style/Theme.Vvtts">

        <!-- directBootAware: the engine can start and speak on the lock screen
             ( before first unlock(. Settings are mirrored to device-protected storage
             by the service each time it starts unlocked; the first-ever locked start
             uses defaults. -->
        <!-- 2026-10-01 regression: a cold `:tts` process could reply to a voice
            query with an exception-status parcel before it was ready, which Settings
            decodes as an NPE. Fix: never-throw guards on all voice-family methods
            ( voiceSafe( so cold queries reply validly;the `:tts` isolation stays
            so synthesis load never janks the app's UI thread or dies with it. -->
        <service
            android:name=".services.VvTtsService"
            android:label="@string/app_name"
            android:exported="true"
            android:process=":tts"
            android:stopWithTask="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.speech.tts" android:resource="@xml/tts_engine" />
        </service>

        <activity android:name=".ui.SettingsActivity" android:label="@string/app_name" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.CheckVoiceData" android:exported="true">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.VoiceProfileActivity"
            android:label="@string/voice_profile"
            android:exported="false"
            android:theme="@style/Theme.Vvtts" />

        <activity android:name=".ui.GetSampleText" android:exported="true">
            <intent-filter>
                <action android:name="android.speech.tts.engine.GET_SAMPLE_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>