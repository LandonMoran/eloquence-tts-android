<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.android.packageinstaller" />
        <package android:name="com.google.android.packageinstaller" />
    </queries>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Signature-level gate for the install-status broadcast channel
         (ElqUpdateInstaller registers its receiver with this permission
         on devices below Android 13, where RECEIVER_NOT_EXPORTED is absent). -->
    <permission
        android:name="com.xw.vvtts.permission.INSTALL_STATUS"
        android:protectionLevel="signature" />

    <application
        android:name=".VvttsApp"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:theme="@style/Theme.Vvtts">

        <!-- Privacy: Crashlytics crash reporting is enabled (it is the app's primary
             diagnostics surface, incl. native engine crashes from the :tts
             process) and never collects synthesized speech text. GA4 analytics is
             OFF by default: nothing is uploaded from it until a Settings > Share
             usage analytics opt-in enables it. The Perf monitor surface was removed
             (see build.gradle) and ships no manifest meta-data. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />

        <!-- directBootAware: the engine can start and speak on the lock screen
             ( before first unlock(. Settings are mirrored to device-protected storage
             by the service each time it starts unlocked; the first-ever locked start
             uses defaults. -->
        <!-- 2026-10-01 regression: a cold `:tts` process could reply to a voice
            query with an exception-status parcel before it was ready, which Settings
            decodes as an NPE. Fix: never-throw guards on all voice-family methods
            ( voiceSafe( so cold queries reply validly;the `:tts` isolation stays
            so synthesis load never janks the app's UI thread or dies with it. -->
        <service
            android:name=".services.VvTtsService"
            android:label="@string/app_name"
            android:exported="true"
            android:process=":tts"
            android:stopWithTask="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.speech.tts" android:resource="@xml/tts_engine" />
        </service>

        <activity android:name=".ui.SettingsActivity" android:label="@string/app_name" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".update.FcmUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity android:name=".ui.CheckVoiceData" android:exported="true">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.VoiceProfileActivity"
            android:label="@string/voice_profile"
            android:exported="false"
            android:theme="@style/Theme.Vvtts" />

        <activity android:name=".ui.GetSampleText" android:exported="true">
            <intent-filter>
                <action android:name="android.speech.tts.engine.GET_SAMPLE_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Background update notifications: fired by the daily AlarmManager alarm
             (UpdateNotificationScheduler). exported=false so only the app's own
             broadcast pending intent can deliver to it. -->
        <receiver
            android:name=".update.UpdateNotificationReceiver"
            android:exported="false" />
    </application>
</manifest>