# The n rule: pinyin 'n' - the nasal coda, whose rule re-enters the
# u-umlaut machine for the nu digraph.  Transcribed from
# apply_chi_n_rules at 0x595ec.  After the fence and the first test the
# machine saves the scan position, pushes the count, and either
# inserts the an-final or walks the ten-case follow table.

rule apply_chi_n_rules from chs.obj
shape frame 464 argbase 8 params 3
label L0 was _apply_chi_n_rules
  load movl slotaddr -136 into r0
  push imm 0
  push slotaddr -136
  call setjmp3 arity 2 depth 2
  cmp testl reg r0 reg r0
  load movl state 0 into r6
  popreg r1
  popreg r1
  branch jne to L1
  load movl slotaddr -136 into r0
  push slotaddr -136
  load movl slotaddr -72 into r0
  push slotaddr -72
  load movl slotaddr -48 into r0
  push slotaddr -48
  load movl slotaddr -60 into r0
  push slotaddr -60
  load movl slotaddr -228 into r0
  push slotaddr -228
  push state 0
  call ventproc arity 6 depth 6
  popn 6
  cmp testl reg r0 reg r0
  branch jne to L1
  load movl param 3 into r7
  push reg r7
  load movl slotaddr -16 into r0
  push slotaddr -16
  push param 1
  load movl slotaddr -24 into r0
  push slotaddr -24
  push state 0
  call get_parm arity 5 depth 5
  push imm 0
  push imm 0
  push state 0
  call fence arity 3 depth 6
  push imm 1
  push state 0
  call starttest arity 2 depth 8
  push imm 1
  push state 0
  call setscan_nof_r arity 2 depth 10
  push sym chs_n_t1
  push imm 1
  push state 0
  call test_string_s arity 3 depth 13
  cmp testl reg r0 reg r0
  branch je to L4
  push imm 2
  push slotaddr -4
  push state 0
  call savescptr arity 3 depth 16
  push imm 3
  push state 0
  call bspush_ca_scan arity 2 depth 18
  push imm 1
  push imm 3
  push imm 2
  push state 0
  call testFldeq arity 4 depth 22
  cmp testl reg r0 reg r0
  branch jne to L4
  push state 0
  call advance_tok arity 1 depth 22
  cmp testl reg r0 reg r0
  branch jne to L4
  push imm 4
  push state 0
  call bspush_ca_scan arity 2 depth 24
  push imm 5
  push sym chs_a_ladder
  push state 0
  call test_synch arity 3 depth 27
  cmp testl reg r0 reg r0
  branch jne to L4
label L3 was_at_a2_insert
  push sym chs_n_ins1
  push imm 1
  push imm 2
  push state 0
  call insert_2pt_s arity 4 depth 31
  cmp testl reg r0 reg r0
  branch je to L2
label L4 was_at_b_arm
  push imm 8
  push state 0
  call starttest arity 2 depth 29
  push sym chs_n_ins1
  push imm 1
  push state 0
  call test_string_s arity 3 depth 32
  cmp testl reg r0 reg r0
  branch je to L3
  push sym chs_n_ins2
  push imm 2
  push imm 1
  push state 0
  call insert_2pt_s arity 4 depth 36
  cmp testl reg r0 reg r0
  branch je to L2
  push state 0
  call followed_by_er arity 1 depth 36
  cmp testl reg r0 reg r0
  branch jne to L4
label L2 was_at_done
  store movl reg r0 ind reg r7 4
  push reg r6
  call succeed arity 1 depth 1
  load movl imm 0 into r0
  return reg r0
label L1 was_at_fail
  push imm 94
  push reg r6
  call vretproc arity 2 depth 2
  popreg r1
  popreg r1
  load movl imm 94 into r0
  return reg r0
end