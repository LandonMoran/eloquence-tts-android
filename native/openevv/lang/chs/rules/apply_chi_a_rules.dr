  branch je to L7
  push imm 16
  push state 0
  call starttest arity 2 depth 25
  push sym chs_a_b4
  push imm 1
  push state 0
  call test_string_s arity 3 depth 28
  cmp testl reg r0 reg r0
  branch je to L7
  push imm 18
  push state 0
  call starttest arity 2 depth 31
  push sym chs_a_b5
  push imm 1
  push state 0
  call test_string_s arity 3 depth 34
  cmp testl reg r0 reg r0
  branch je to L2
  push sym chs_a_fin8
