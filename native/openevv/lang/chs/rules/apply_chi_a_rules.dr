# The a rule: pinyin 'a' - the first and most common vowel, and the
# syllable engine for every a-final.  Transcribed from
# apply_chi_a_rules at 0x5791c.  The machine fences on the tone ladder,
# then walks the compound-final arms: each is a savescptr/set-test
# pair, an advance on the token stream, a synchronised fence on one of
# the a family's substrings, and an insert of the final's phone.

rule apply_chi_a_rules from chs.obj
shape frame 480 argbase 8 params 3
label L0 was _apply_chi_a_rules
  load movl slotaddr -136 into r0
  push imm 0
  push slotaddr -136
  call setjmp3 arity 2 depth 2
  cmp testl reg r0 reg r0
  load movl state 0 into r6
