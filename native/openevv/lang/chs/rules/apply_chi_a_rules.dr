# The a rule: pinyin 'a' — the first vowel.  Transcribed from
# apply_chi_a_rules at 0x5791c.  The main arm fences on the a-ladder,
# starts the test, loads-and-scans, then inserts the a-final from the
# ladder: the plain a, the tone two, and the compound fallbacks.

rule apply_chi_a_rules from chs.obj
shape frame 480 argbase 8 params 3
label L0 was _apply_chi_a_rules
  load movl slotaddr -136 into r0
  push imm 0
  push slotaddr -136
  call setjmp3 arity 2 depth 2
  cmp testl reg r0 reg r0
  load movl state 0 into r6
  popreg r1
  popreg r1
  branch jne to L1
  load movl slotaddr -136 into r0
  push slotaddr -136
  load movl slotaddr -72 into r0
  push slotaddr -72
  load movl slotaddr -48 into r0
  push slotaddr -48
  load movl slotaddr -60 into r0
  push slotaddr -60
  load movl slotaddr -228 into r0
  push slotaddr -228
  push state 0
  call ventproc arity 6 depth 6
  popn 6
  cmp testl reg r0 reg r0
  branch jne to L1
  load movl param 3 into r7
  push reg r7
  load movl slotaddr -16 into r0
  push slotaddr -16
  push param 1
  load movl slotaddr -24 into r0
  push slotaddr -24
  push state 0
  call get_parm arity 5 depth 5
  push imm 0
  push imm 0
  push state 0
  call fence arity 3 depth 8
  push imm 1
  push sym chs_a_ladder
  push state 0
  call fence arity 3 depth 11
  push imm 1
  push state 0
  call starttest arity 2 depth 13
  push sym chs_a_t1
  push imm 1
  push state 0
  call test_string_s arity 3 depth 16
  cmp testl reg r0 reg r0
  branch jne to L2
  push sym chs_a_fin1
  push imm 1
  push imm 2
  push state 0
  call insert_2pt_s arity 4 depth 20
  cmp testl reg r0 reg r0
  branch je to L3
label L2 was the_tone_two_arm
  push sym chs_a_t2
  push imm 1
  push state 0
  call test_string_s arity 3 depth 19
  cmp testl reg r0 reg r0
  branch jne to L4
  push sym chs_a_fin2
  push imm 1
  push imm 2
  push state 0
  call insert_2pt_s arity 4 depth 23
  cmp testl reg r0 reg r0
  branch je to L3
label L4 was the_compound_arm
  push sym chs_a_fin3
  push imm 1
  push imm 2
  push state 0
  call insert_2pt_s arity 4 depth 20
  cmp testl reg r0 reg r0
  branch je to L3
  load movl slotaddr -4 into r0
  push slotaddr -4
  push state 0
  call backtrack_function arity 2 depth 2
  popreg r1
  popreg r1
label L1 was_at_done
  push imm 94
  push reg r6
  call vretproc arity 2 depth 2
  popreg r1
  popreg r1
  load movl imm 94 into r0
  return reg r0
label L3 was_succeed
  push reg r6
  call succeed arity 1 depth 1
  load movl imm 0 into r0
  return reg r0
end