  push state 0
  call test_string_s arity 3 depth 20
  cmp testl reg r0 reg r0
  branch je to L6
  push imm 5
  push sym chs_a_ladder
  push state 0
  call test_synch arity 3 depth 23
  cmp testl reg r0 reg r0
  branch jne to L5
  push sym chs_a_fin6
  push imm 1
  push imm 2
  push state 0
  call insert_2pt_s arity 4 depth 27
  cmp testl reg r0 reg r0
  branch je to L4
label L6 was the_fall_arm
  push imm 6
  push sym chs_a_ladder
  push state 0
  call test_synch arity 3 depth 20
  cmp testl reg r0 reg r0
