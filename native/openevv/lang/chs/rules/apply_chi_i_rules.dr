# The i rule: pinyin 'i' - the front vowel.  Transcribed from
# apply_chi_i_rules at 0x58298.  Same engine as the e rule: fences,
# then a chained test on the i-grapheme, an insert of the i final, and
# the vback retry on the following token.

rule apply_chi_i_rules from chs.obj
shape frame 480 argbase 8 params 3
label L0 was _apply_chi_i_rules
  load movl slotaddr -136 into r0
  push imm 0
  push slotaddr -136
  call setjmp3 arity 2 depth 2
  cmp testl reg r0 reg r0
  load movl state 0 into r6
  popreg r1
  popreg r1
  branch jne to L1
  load movl slotaddr -136 into r0
  push slotaddr -136
  load movl slotaddr -72 into r0
  push slotaddr -72
  load movl slotaddr -48 into r0
  push slotaddr -48
  load movl slotaddr -60 into r0
  push slotaddr -60
  load movl slotaddr -228 into r0
  push slotaddr -228
  push state 0
  call ventproc arity 6 depth 6
  popn 6
  cmp testl reg r0 reg r0
  branch jne to L1
  push imm 0
  push imm 0
  push state 0
  call fence arity 3 depth 9
  push imm 1
  push sym chs_a_ladder
  push state 0
  call fence arity 3 depth 12
  push imm 1
  push state 0
  call starttest arity 2 depth 14
  push imm 1
  push state 0
  call setscan_r arity 2 depth 16
  cmp testl reg r0 reg r0
  branch jne to L2
  push imm 16
  push state 0
  call starttest arity 2 depth 18
  push imm 17
  push state 0
  call bspush_ca_scan arity 2 depth 20
  push sym chs_i_t1
  push imm 1
  push state 0
  call test_string_s arity 3 depth 23
  cmp testl reg r0 reg r0
  branch jne to L2
  push imm 20
  push state 0
  call starttest arity 2 depth 26
  push sym chs_a_fin6
  push imm 1
  push imm 2
  push state 0
  call insert_2pt_s arity 4 depth 30
  cmp testl reg r0 reg r0
  branch je to L4
label L2 was_the_retry_scan
  push imm 0
  push state 0
  call vback arity 2 depth 20
  popreg r1
  popreg r1
label L1 was_at_done
  push imm 94
  push reg r6
  call vretproc arity 2 depth 2
  popreg r1
  popreg r1
  load movl imm 94 into r0
  return reg r0
label L4 was_succeed
  push reg r6
  call succeed arity 1 depth 1
  load movl imm 0 into r0
  return reg r0
end