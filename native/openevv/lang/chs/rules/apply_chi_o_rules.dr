# The o rule: pinyin 'o'.  Transcribed from apply_chi_o_rules at
# 0x58aac.  The lighter 448-frame machine: one test on the o-grapheme
# after an advance, the o-final inserts, and the short retry loop for
# the following token.

rule apply_chi_o_rules from chs.obj
shape frame 448 argbase 8 params 2
label L0 was _apply_chi_o_rules
  load movl slotaddr -136 into r0
  push imm 0
  push slotaddr -136
  call setjmp3 arity 2 depth 2
  cmp testl reg r0 reg r0
  load movl state 0 into r6
  popreg r1
  popreg r1
  branch jne to L1
  load movl slotaddr -136 into r0
  push slotaddr -136
  load movl slotaddr -72 into r0
  push slotaddr -72
  load movl slotaddr -48 into r0
  push slotaddr -48
  load movl slotaddr -60 into r0
  push slotaddr -60
  load movl slotaddr -228 into r0
  push slotaddr -228
  push state 0
  call ventproc arity 6 depth 6
  popn 6
  cmp testl reg r0 reg r0
  branch jne to L1
  push imm 0
  push imm 0
  push state 0
  call fence arity 3 depth 9
  push imm 1
  push sym chs_a_ladder
  push state 0
  call fence arity 3 depth 12
  push imm 1
  push state 0
  call advance_tok arity 1 depth 13
  cmp testl reg r0 reg r0
  branch jne to L2
  push sym chs_o_t1
  push imm 1
  push state 0
  call test_string_s arity 3 depth 16
  cmp testl reg r0 reg r0
  branch jne to L3
label L2 was_the_second_arm
  push imm 2
  push slotaddr -4
  push state 0
  call savescptr arity 3 depth 19
  push sym chs_o_t2
  push imm 1
  push state 0
  call test_string_s arity 3 depth 22
  cmp testl reg r0 reg r0
  branch je to L5
  push imm 4
  push sym chs_a_ladder
  push state 0
  call test_synch arity 3 depth 25
  cmp testl reg r0 reg r0
  branch jne to L6
  push sym chs_o_ins4
  push imm 1
  push imm 2
  push state 0
  call insert_2pt_s arity 4 depth 29
  cmp testl reg r0 reg r0
  branch je to L4
label L6 was_the_retry_scan
  push imm 0
  push state 0
  call vback arity 2 depth 23
  popreg r1
  popreg r1
label L1 was_at_done
  push imm 94
  push reg r6
  call vretproc arity 2 depth 2
  popreg r1
  popreg r1
  load movl imm 94 into r0
  return reg r0
label L3 was_the_third_arm
  push imm 9
  push state 0
  call starttest arity 2 depth 16
  push sym chs_o_t3
  push imm 1
  push state 0
  call test_string_s arity 3 depth 19
  cmp testl reg r0 reg r0
  branch jne to L2
  push sym chs_o_ins1
  push imm 1
  push imm 2
  push state 0
  call insert_2pt_s arity 4 depth 23
  cmp testl reg r0 reg r0
  branch je to L4
label L5 was_the_fourth_arm
  push sym chs_o_ins3
  push imm 1
  push imm 2
  push state 0
  call insert_2pt_s arity 4 depth 26
  cmp testl reg r0 reg r0
  branch je to L4
label L4 was_succeed
  push reg r6
  call succeed arity 1 depth 1
  load movl imm 0 into r0
  return reg r0
end