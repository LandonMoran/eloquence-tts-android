# The u rule: pinyin 'u' - the back vowel, home of the er-hua
# (rhotic) finals.  Transcribed from apply_chi_u_rules at 0x58c98.
# The chained arms each bspush a count and test a half of the u
# graphemes, then fall to the inserts of the u finals or the retry
# loop on the following token.  The followed_by_er check is the state
# lookahead for the er-final; the VM's own context covers it.

rule apply_chi_u_rules from chs.obj
shape frame 480 argbase 8 params 3
label L0 was _apply_chi_u_rules
